<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="KUSUMORA — a little luxury at your fingertips. Handmade press-on nails in soft, thoughtful designs." />
  <title>KUSUMORA | A little luxury at your fingertips</title>
  <style>
    :root {
      --cream: #f8f2e8;
      --paper: #fffdf9;
      --sage: #a8b49a;
      --sage-dark: #65765a;
      --blush: #e8c3c2;
      --gold: #d5b779;
      --ink: #393a30;
      --muted: #77776c;
      --line: #e8e0d3;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; color: var(--ink); background: var(--paper); font-family: Georgia, "Times New Roman", serif; }
    a { color: inherit; text-decoration: none; }
    .announcement { background: var(--sage-dark); color: #fffdf8; text-align: center; padding: 9px 16px; font: 11px/1.4 Arial, sans-serif; letter-spacing: .12em; }
    header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px clamp(18px, 6vw, 80px); border-bottom: 1px solid var(--line); }
    .brand { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .brand-logo { display: block; width: 178px; height: auto; object-fit: contain; }
    footer .brand-logo { width: 145px; }
    .brand:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
    @media (max-width: 760px) { .brand-logo { width: 132px; } footer .brand-logo { width: 125px; } }
    nav { display: flex; align-items: center; gap: 24px; font: 12px Arial, sans-serif; }
    nav a:hover { color: var(--sage); }
    .nav-cta, .button { display: inline-block; background: var(--sage-dark); color: white; padding: 13px 19px; border-radius: 2px; font: 11px Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; transition: .2s; }
    .nav-cta:hover, .button:hover { background: var(--sage); transform: translateY(-1px); }
    .hero { background: var(--cream); display: grid; grid-template-columns: 1.05fr .95fr; min-height: 500px; align-items: center; padding: 55px clamp(18px, 8vw, 110px); gap: 40px; }
    .eyebrow { color: var(--sage); font: 10px Arial, sans-serif; letter-spacing: .22em; text-transform: uppercase; }
    h1 { font-size: clamp(42px, 5.4vw, 72px); line-height: 1.04; font-weight: 400; margin: 18px 0; }
    h1 em { color: var(--sage); font-weight: 400; }
    .hero p { max-width: 430px; color: #6b6a5e; font: 14px/1.8 Arial, sans-serif; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
    .button.secondary { background: transparent; color: var(--sage-dark); border: 1px solid var(--sage-dark); }
    .hero-art { min-height: 350px; position: relative; display: flex; align-items: center; justify-content: center; }
    .sun { width: min(340px, 75vw); aspect-ratio: 1; border-radius: 50%; background: #eadfd0; position: absolute; }
    .arch { position: absolute; width: 235px; height: 300px; border: 1px solid var(--gold); border-bottom: 0; border-radius: 130px 130px 0 0; top: 28px; }
    .nails { position: relative; display: flex; gap: 9px; align-items: center; transform: rotate(-8deg); z-index: 1; }
    .nail { width: 36px; height: 100px; border-radius: 22px 22px 14px 14px; background: linear-gradient(135deg,#f9e7df,#d7a9a0); border: 1px solid rgba(120,90,70,.2); box-shadow: 0 12px 20px #a58c7330; }
    .nail:nth-child(2), .nail:nth-child(4) { height: 119px; background: linear-gradient(135deg,#fff5e9,#e7c9bb); }
    .nail:nth-child(3) { height: 132px; background: linear-gradient(135deg,#e8eadb,#aab397); }
    .nail:nth-child(5) { height: 91px; background: linear-gradient(135deg,#e9c2c0,#c98f91); }
    .sparkle { position: absolute; color: var(--gold); font-size: 24px; }
    .s1 { top: 38px; right: 16%; } .s2 { bottom: 50px; left: 12%; font-size: 18px; }
    section { padding: 75px clamp(18px, 7vw, 95px); }
    .section-heading { text-align: center; max-width: 620px; margin: 0 auto 38px; }
    .section-heading h2 { font-size: clamp(30px, 4vw, 44px); font-weight: 400; margin: 12px 0; }
    .section-heading p { color: var(--muted); font: 13px/1.7 Arial, sans-serif; }
    .products { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .product { border: 1px solid var(--line); background: white; padding-bottom: 20px; }
    .product-art { height: 190px; display: flex; align-items: center; justify-content: center; gap: 5px; background: var(--cream); overflow: hidden; }
    .product-art .nail { width: 23px; height: 76px; }
    .product-art .nail:nth-child(2), .product-art .nail:nth-child(4) { height: 90px; }
    .product-art .nail:nth-child(3) { height: 100px; }
    .product:nth-child(2) .product-art { background: #f3e8df; }
    .product:nth-child(2) .nail { background: linear-gradient(180deg,#fff9ee 0 72%,#fdfdf8 72%); border-color: #d8cabb; }
    .product:nth-child(3) .product-art { background: #f3ece8; }
    .product:nth-child(3) .nail { background: linear-gradient(135deg,#f3d7d2,#d7a5a2); }
    .product:nth-child(4) .product-art { background: #e9ebdf; }
    .product:nth-child(4) .nail { background: linear-gradient(135deg,#f9eee0,#c7cdb4); }
    .product-info { padding: 17px 16px 0; }
    .product-info h3 { font-size: 19px; font-weight: 400; margin: 0 0 7px; }
    .product-info p { font: 12px/1.6 Arial, sans-serif; color: var(--muted); min-height: 38px; margin: 0 0 12px; }
    .price-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .price { font-size: 17px; color: var(--sage-dark); }
    .small-link { font: 10px Arial, sans-serif; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid var(--gold); padding-bottom: 3px; }
    .note { text-align: center; margin-top: 24px; font: 11px/1.7 Arial, sans-serif; color: var(--muted); }
    .story { background: var(--cream); display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: 55px; }
    .story-mark { min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; border: 1px solid #d9c9a7; outline: 1px solid #d9c9a7; outline-offset: -10px; background: radial-gradient(circle at 50% 40%, #fffaf2, #f0e5d7); color: var(--sage-dark); position: relative; }
    .lotus-mark { color: var(--gold); font-size: 54px; line-height: 1; }
    .story-mark span { font-size: 44px; letter-spacing: .1em; }
    .story-mark small { font: 9px Arial, sans-serif; letter-spacing: .2em; color: var(--muted); margin-top: 6px; }
    .brand-values { background: #fffaf4; }
    .values-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; max-width: 1000px; margin: auto; }
    .values-grid article { text-align: center; padding: 28px 22px; background: var(--cream); border: 1px solid var(--line); }
    .value-symbol { color: var(--gold); font-size: 30px; }
    .values-grid h3 { font-size: 20px; font-weight: 400; margin: 12px 0 8px; }
    .values-grid p { color: var(--muted); font: 12px/1.8 Arial, sans-serif; margin: 0; }
    .story h2 { font-size: clamp(30px, 4vw, 44px); font-weight: 400; margin: 12px 0 20px; }
    .story p { font: 13px/1.9 Arial, sans-serif; color: #6b6a5e; }
    .steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
    .step { border-top: 1px solid var(--gold); padding-top: 18px; }
    .step .number { color: var(--sage); font-size: 27px; }
    .step h3 { font-size: 20px; font-weight: 400; margin: 10px 0; }
    .step p { font: 12px/1.8 Arial, sans-serif; color: var(--muted); }
    .cta-band { background: var(--sage-dark); color: var(--paper); text-align: center; padding: 58px 20px; }
    .cta-band h2 { font-size: clamp(30px, 4vw, 43px); font-weight: 400; margin: 10px 0; }
    .cta-band p { font: 13px/1.7 Arial, sans-serif; color: #e5e4d9; }
    .cta-band .button { background: var(--paper); color: var(--sage-dark); margin-top: 15px; }
    footer { padding: 35px 20px; text-align: center; background: var(--cream); }
    footer .brand { font-size: 20px; }
    footer p { font: 11px/1.8 Arial, sans-serif; color: var(--muted); }
    .footer-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 20px; margin: 16px 0; font: 11px Arial, sans-serif; }
    .fineprint { font-size: 10px; }
    @media (max-width: 850px) {
      nav { gap: 12px; } nav a:not(.nav-cta) { display: none; }
      .hero { grid-template-columns: 1fr; padding-top: 45px; text-align: center; }
      .hero p { margin-left: auto; margin-right: auto; }
      .hero-actions { justify-content: center; }
      .hero-art { min-height: 310px; }
      .products { grid-template-columns: repeat(2,1fr); }
      .story { grid-template-columns: 1fr; gap: 30px; }
      .values-grid { grid-template-columns: 1fr; }
      .story-mark { min-height: 210px; }
    }
    @media (max-width: 480px) {
      header { padding: 16px; } .brand { font-size: 21px; }
      .nav-cta { padding: 11px 12px; font-size: 10px; }
      section { padding-top: 55px; padding-bottom: 55px; }
      .products { gap: 10px; }
      .product-art { height: 150px; }
      .product-info { padding: 13px 11px 0; }
      .product-info h3 { font-size: 17px; }
      .price-row { align-items: flex-start; flex-direction: column; }
      .steps { grid-template-columns: 1fr; gap: 25px; }
    }
  </style>
</head>
<body>
  <div class="announcement">A LITTLE LUXURY AT YOUR FINGERTIPS · MADE TO ORDER</div>
  <header>
    <a class="brand" href="#home" aria-label="KUSUMORA home"><img class="brand-logo" src="data:image/jpeg;base64," alt="KUSUMORA floral logo in sage, blush and champagne gold"></a>
    <nav aria-label="Main navigation">
      <a href="#collections">Collections</a>
      <a href="#about">Our story</a>
      <a href="#identity">Our identity</a>
      <a href="#how-to-order">How to order</a>
      <a class="nav-cta" href="#order">Order your set</a>
    </nav>
  </header>

  <main>
    <section class="hero" id="home">
      <div>
        <div class="eyebrow">Thoughtfully made · Naturally you</div>
        <h1>A little luxury<br><em>at your fingertips.</em></h1>
        <p>Meet your new little ritual. Explore soft everyday shades, elegant French tips and custom nail art, thoughtfully made to bring a touch of beauty to the everyday.</p>
        <div class="hero-actions">
          <a class="button" href="#collections">Explore the sets</a>
          <a class="button secondary" href="#how-to-order">How it works</a>
        </div>
      </div>
      <div class="hero-art" aria-label="Illustration of a soft neutral press-on nail set">
        <div class="sun"></div><div class="arch"></div>
        <div class="nails"><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span></div>
        <span class="sparkle s1">✧</span><span class="sparkle s2">✦</span>
      </div>
    </section>

    <section id="collections">
      <div class="section-heading">
        <div class="eyebrow">The KUSUMORA signature</div>
        <h2>Designed for your kind of pretty</h2>
        <p>Handmade sets for everyday wear, special moments, and everything in between.</p>
      </div>
      <div class="products">
        <article class="product">
          <div class="product-art"><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span></div>
          <div class="product-info"><h3>Everyday Set</h3><p>Glossy solids, soft nudes and timeless shades.</p><div class="price-row"><span class="price">₹249–₹299</span><a class="small-link order-link" data-product="Everyday Set" href="#order">Enquire</a></div></div>
        </article>
        <article class="product">
          <div class="product-art"><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span></div>
          <div class="product-info"><h3>French Edit</h3><p>Classic French tips, micro-French and subtle chrome.</p><div class="price-row"><span class="price">₹349–₹449</span><a class="small-link order-link" data-product="French Edit" href="#order">Enquire</a></div></div>
        </article>
        <article class="product">
          <div class="product-art"><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span></div>
          <div class="product-info"><h3>Bloom Collection</h3><p>Sweet florals, bows and delicate little details.</p><div class="price-row"><span class="price">₹399–₹549</span><a class="small-link order-link" data-product="Bloom Collection" href="#order">Enquire</a></div></div>
        </article>
        <article class="product">
          <div class="product-art"><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span><span class="nail"></span></div>
          <div class="product-info"><h3>Custom Set</h3><p>Your colours, your inspo, your own little nail story.</p><div class="price-row"><span class="price">₹499–₹699+</span><a class="small-link order-link" data-product="Custom Set" href="#order">Enquire</a></div></div>
        </article>
      </div>
      <p class="note">Prices are starting estimates. Final pricing depends on nail shape, sizing and design details. Delivery is calculated separately.</p>
    </section>

    <section class="story" id="about">
      <div class="story-mark" aria-hidden="true"><div class="lotus-mark">✿</div><span>K</span><small>BEAUTY IN THE DETAILS</small></div>
      <div>
        <div class="eyebrow">The heart of KUSUMORA</div>
        <h2>Soft beauty. Personal expression.</h2>
        <p>KUSUMORA is built around a simple idea: beauty can be personal, effortless and full of little details. Inspired by soft botanicals and the calm elegance of cream, sage, blush and champagne gold, our visual world feels feminine without being fussy.</p>
        <p>From affordable everyday sets to one-of-a-kind custom designs, each set is made to feel like you. Choose your collection, share your inspiration and let your nails tell their own story.</p>
      </div>
    </section>

    <section class="brand-values" id="identity">
      <div class="section-heading">
        <div class="eyebrow">More than a pretty set</div>
        <h2>The KUSUMORA identity</h2>
        <p>A soft, botanical-inspired world made for everyday beauty and personal expression.</p>
      </div>
      <div class="values-grid">
        <article><span class="value-symbol">❀</span><h3>Botanical elegance</h3><p>A delicate floral mark inspired by blooming petals — the signature detail across our brand.</p></article>
        <article><span class="value-symbol">✧</span><h3>Soft sophistication</h3><p>Cream, sage, blush and champagne gold create a calm, feminine palette without harsh dark tones.</p></article>
        <article><span class="value-symbol">♡</span><h3>Made personal</h3><p>Easy everyday favourites and custom designs, with room for your own colours, shape and inspiration.</p></article>
      </div>
    </section>

    <section id="how-to-order">
      <div class="section-heading">
        <div class="eyebrow">Simple as 1, 2, 3</div>
        <h2>How to order</h2>
        <p>A few quick steps to your next favourite set.</p>
      </div>
      <div class="steps">
        <div class="step"><div class="number">01</div><h3>Pick your design</h3><p>Choose a collection or send us your reference pictures, colour ideas and preferred nail shape.</p></div>
        <div class="step"><div class="number">02</div><h3>Confirm your size</h3><p>We’ll guide you through nail sizing, set details, pricing and estimated making time.</p></div>
        <div class="step"><div class="number">03</div><h3>Made just for you</h3><p>Once your order is confirmed, your set is handmade and packed with care. Delivery is charged separately.</p></div>
      </div>
    </section>

    <section class="cta-band" id="order">
      <div class="eyebrow" style="color:#e8d4a7">Your next set is waiting</div>
      <h2>Let’s create your kind of pretty.</h2>
      <p>Message us to place an order, ask about sizing or discuss a custom design.</p>
      <a class="button" id="whatsapp-button" href="#" target="_blank" rel="noopener">Order via WhatsApp</a>
      <p style="font-size:11px;margin-top:14px">Replace the demo WhatsApp number in the website file with your business number before publishing.</p>
    </section>
  </main>

  <footer>
    <div class="brand"><img class="brand-logo" src="data:image/jpeg;base64," alt="KUSUMORA floral logo in sage, blush and champagne gold"></div>
    <div class="footer-links"><a href="#collections">Collections</a><a href="#about">Our story</a><a href="#identity">Our identity</a><a href="#how-to-order">How to order</a><a id="instagram-link" href="#" target="_blank" rel="noopener">Instagram</a></div>
    <p>Handmade with care, one set at a time.</p>
    <p class="fineprint">© <span id="year"></span> KUSUMORA. All rights reserved.</p>
  </footer>

  <script>
    // SET THESE BEFORE PUBLISHING:
    const WHATSAPP_NUMBER = "91XXXXXXXXXX"; // Example format: 919876543210 (country code, no + or spaces)
    const INSTAGRAM_URL = "https://instagram.com/yourusername";

    const waMessage = "Hi KUSUMORA! I'd like to enquire about your press-on nails. Please share the available designs, sizing details and delivery charges.";
    const waLink = "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(waMessage);
    const waButton = document.getElementById("whatsapp-button");
    waButton.href = waLink;
    waButton.addEventListener("click", function (event) {
      if (WHATSAPP_NUMBER.includes("X")) {
        event.preventDefault();
        alert("Please add your WhatsApp business number in the website code before using this button.");
      }
    });
    document.getElementById("instagram-link").href = INSTAGRAM_URL;
    document.getElementById("year").textContent = new Date().getFullYear();
    document.querySelectorAll(".order-link").forEach(function(link) {
      link.addEventListener("click", function() {
        const product = link.dataset.product;
        const message = "Hi KUSUMORA! I'm interested in the " + product + ". Please share the designs, sizing details and delivery charges.";
        waButton.href = "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(message);
      });
    });
  </script>
</body>
</html>
